import knime.scripting.io as knio
from sklearn.naive_bayes import CategoricalNB

# 1. Ambil data (sudah berupa angka dari node Category to Number)
df = knio.input_tables[0].to_pandas()

# 2. Pisahkan Fitur dan Target
# (Hapus kolom 'Day' jika belum di-drop di node sebelumnya)
if 'Day' in df.columns:
    df = df.drop(columns=['Day'])

X = df.iloc[:, :-1].values # Fitur
y = df.iloc[:, -1].values  # Target ('Play' yang sudah jadi angka)

# 3. Training Model
model = CategoricalNB()
model.fit(X, y)

# 4. Prediksi
predictions = model.predict(X)
df['Prediction'] = predictions

# 5. Output kembali ke KNIME
knio.output_tables[0] = knio.Table.from_pandas(df)
